# ---------------------------------------------------------------------------
# 模型服务：默认使用阿里云百炼（DashScope）的 OpenAI 兼容模式
# ---------------------------------------------------------------------------
# 在 https://bailian.console.aliyun.com/ 申请，形如 sk-xxxxxxxx
DASHSCOPE_API_KEY=

# 中国大陆站账号用默认值；国际站账号改为 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
# 推理型模型（如 qwen3.x-flash）默认会先流式输出一大段思考内容，之后才出答案。
# 实测本语料下：开启思考时首个答案 token 约 8.6s，关闭后约 0.7s。
# 事实型问答不需要这段推理，默认关闭；需要多步推理时可改为 true。
LLM_ENABLE_THINKING=false

# 备用模型候选（逗号分隔，可留空）。主模型在拿到首个流式分片前失败（403 配额 /
# 429 限流 / 超时 / 连接错误）时按序切换，并通过 SSE notice 事件告知用户。
# 例：LLM_FALLBACK_MODELS=qwen-flash,qwen-turbo
LLM_FALLBACK_MODELS=
# 连续失败多少次后熔断一个模型：冷却期内直接跳过，不再每次请求都先撞一次死模型
LLM_BREAKER_THRESHOLD=3
# 熔断冷却秒数：冷却结束后放一次探测请求，成功即恢复该模型
LLM_BREAKER_COOLDOWN=60

# ---------------------------------------------------------------------------
# Embedding：走本地已下载的模型权重（无需联网、数据不出本机）
# 若想改回百炼云端，把 EMBEDDING_PROVIDER 改成 dashscope 即可
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_LOCAL_PATH=C:/code/agent/rag/models/bge-m3
# Docker 部署时改成容器内路径：/models/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# bge-m3 输出 1024 维，必须与 EMBEDDING_DIMENSIONS 一致，否则 Qdrant 写入会失败
EMBEDDING_DIMENSIONS=1024

# 云端 embedding 时才需要（EMBEDDING_PROVIDER=dashscope）
EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------------------------------------------------------------------------
# 重排：local-bge（本地权重）/ dashscope（云端，需 API key）/ noop
# ---------------------------------------------------------------------------
RERANKER_PROVIDER=local-bge
RERANKER_LOCAL_PATH=C:/code/agent/rag/models/bge-reranker-v2-m3
# Docker 部署时改成容器内路径：/models/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_MODEL=gte-rerank-v2
RERANK_TOP_N=5

# 相关性阈值：低于此分的片段被丢弃，让"知识库里没有答案"变成明确结果而不是硬凑 top-k。
# 0 表示不卡阈值。
#
# 注意：这个值取决于「被重排的文本是什么」。检索层给交叉编码器打的是**子块**（单个行/段落），
# 因为长文本打分在 CPU 上约 2 秒一对，太慢。子块文本很短，分数整体偏低——
# 实测正确命中约 0.05，无关内容约 0.001，所以默认取 0.02。
# 换语料、换重排模型或改 RERANK_CANDIDATES 后，用下面命令重新标定：
#   python scripts/eval_retrieval.py --dense --sweep
RERANK_SCORE_THRESHOLD=0.02

# ---------------------------------------------------------------------------
# 查询改写：检索前把口语化提问与多轮指代补全成规范查询
# ---------------------------------------------------------------------------
QUERY_REWRITE_ENABLED=true
# 改写是轻量转换任务，用更便宜的模型，避免占用对话模型的延迟预算
QUERY_REWRITE_MODEL=qwen-turbo
QUERY_REWRITE_HISTORY_TURNS=4
# 实测单次改写耗时 4~8 秒，超时上限必须留出余量，否则会被误判为失败并回退原查询
QUERY_REWRITE_TIMEOUT=45

# ---------------------------------------------------------------------------
# 检索
# ---------------------------------------------------------------------------
# Word 正文的子块按 token 计量（用本地 embedding 模型自己的 tokenizer 切），
# 而不是字符数。bge-m3 官方建议检索单元 <=512 token；中文 1 字约合 1~2 token。
CHUNK_SIZE_TOKENS=512
# 相邻子块之间重叠的 token 数，需小于 CHUNK_SIZE_TOKENS
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_VECTOR_TOP_K=20
RETRIEVAL_BM25_TOP_K=20
RERANK_CANDIDATES=20

# ---------------------------------------------------------------------------
# Agent
# ---------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=12
# 单轮问答（含工具循环）的全局超时秒数；超时后落库已生成部分并明确告知。
# 必须明显高于单次模型请求超时（工具循环里可能有多次模型调用），默认 300。
CHAT_TURN_TIMEOUT=300

# ---------------------------------------------------------------------------
# 数据分析子 Agent
# ---------------------------------------------------------------------------
# 主 Agent 通过 analyze_and_report 工具，把「分析数据 / 生成报告」类请求委派给一个
# 只读子 Agent（子 Agent 只拿到 readOnlyHint 的工具，改不了文件）。false 关闭该工具。
ANALYSIS_TOOL_ENABLED=true
# 子 Agent 自己的工具循环上限，与主 Agent 的预算分开。
ANALYSIS_MAX_ITERATIONS=8
# 分析子 Agent 使用的模型；留空复用 LLM_MODEL，备用模型链仍然生效。
ANALYSIS_MODEL=

# ---------------------------------------------------------------------------
# 会话记忆压缩
# ---------------------------------------------------------------------------
# 组装历史时保留的最近原文条数；更早的轮次在消息总数超过触发水位后滚动压缩成
# 持久摘要（「摘要 + 最近 N 条原文」注入）。摘要走查询改写的小模型通道，
# 失败自动回退为纯截断，不影响对话。
MEMORY_RECENT_MESSAGES=20
# 压缩触发水位：消息总数超过该值才发起摘要（含用户与助手消息）
MEMORY_COMPACT_TRIGGER=40

# ---------------------------------------------------------------------------
# 意图门控
# ---------------------------------------------------------------------------
# 进 Agent 循环前做一次廉价意图分类（规则优先，模糊时用改写小模型）：
# 闲聊直接回答不进工具循环；查询意图只暴露只读工具（写工具遮蔽）；
# 判定拿不准或分类失败时保守走完整链路。false 关闭门控（全量工具 + 检索链路）。
INTENT_GATE_ENABLED=true

# ---------------------------------------------------------------------------
# 推荐后续问题
# ---------------------------------------------------------------------------
# 回合结束时用改写小模型预测 2~3 个用户最可能的追问，前端以建议 chip 展示
# （点击即发送）。失败即跳过，不影响对话。false 关闭。
FOLLOWUPS_ENABLED=true

# ---------------------------------------------------------------------------
# 邮件 / 日程助手（Gmail + Google Calendar）
# ---------------------------------------------------------------------------
# 关闭后不启动 Google MCP 子进程，也不启动飞书长连接；文档工作区不受影响。
ASSISTANT_ENABLED=true
# 留空复用 LLM_MODEL 与 LLM_FALLBACK_MODELS；可单独指定更便宜/更强的模型。
ASSISTANT_MODEL=
ASSISTANT_MAX_ITERATIONS=8
# 待确认操作的有效期；过期的提案不能再批准执行。
ASSISTANT_ACTION_TTL_HOURS=24
ASSISTANT_TIMEZONE=Asia/Shanghai
ASSISTANT_HISTORY_MESSAGES=30

# OAuth Desktop App 的 client_secret.json；只在一次性授权命令中使用。
GOOGLE_CLIENT_SECRETS_PATH=
# 默认 data/secrets/google_token.json。令牌会自动刷新，不要提交仓库。
GOOGLE_TOKEN_PATH=
# 一般留空，默认使用当前 Python 执行 `python -m mcp_google_server.server`。
GOOGLE_MCP_SERVER_COMMAND=

# ---------------------------------------------------------------------------
# 飞书机器人（官方 SDK WebSocket 长连接，无需公网回调）
# ---------------------------------------------------------------------------
# 应用需启用机器人，订阅 im.message.receive_v1，并配置 card.action.trigger 回调。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# open_id 白名单，逗号分隔。为空时飞书桥接停用（失败关闭，绝不放行所有人）。
FEISHU_ALLOWED_OPEN_IDS=
# 可选：只允许这些 chat_id；为空表示允许白名单用户所在任意群。
FEISHU_ALLOWED_CHAT_IDS=
# 可选：允许点飞书审批卡片的人；为空时沿用 FEISHU_ALLOWED_OPEN_IDS。
FEISHU_APPROVER_OPEN_IDS=

# ---------------------------------------------------------------------------
# 会议助手（本地实时转写 + 会后纪要）
# ---------------------------------------------------------------------------
# 音频不落盘；转写文本会进入现有模型链生成纪要。模型首次录音时下载并加载。
MEETING_ENABLED=true
MEETING_ASR_BACKEND=faster-whisper
MEETING_ASR_MODEL=small
MEETING_ASR_LANGUAGE=zh
MEETING_ASR_DEVICE=cpu
MEETING_ASR_COMPUTE_TYPE=int8
# 可选：已有 CTranslate2 模型目录；留空按模型名从 Hugging Face 缓存/下载。
MEETING_ASR_MODEL_DIR=
# 简体中文由 OpenCC 后处理保证，不再向 Whisper 注入自然语言系统提示。
MEETING_ASR_BEAM_SIZE=2
MEETING_ASR_CONDITION_ON_PREVIOUS_TEXT=true
MEETING_ASR_NO_SPEECH_THRESHOLD=0.6
MEETING_ASR_LOG_PROB_THRESHOLD=-1.0
MEETING_ASR_COMPRESSION_RATIO_THRESHOLD=2.4
MEETING_ASR_HALLUCINATION_SILENCE_THRESHOLD=2.0
MEETING_ASR_COALESCE_SECONDS=1.0
MEETING_ASR_BUFFER_TRIMMING_SECONDS=15.0
MEETING_ASR_PAUSE_SEGMENTATION_SECONDS=3.0
MEETING_SIMPLIFY_CHINESE=true
MEETING_MAX_MINUTES=180
# 留空复用 LLM_MODEL 与 LLM_FALLBACK_MODELS。
MEETING_SUMMARY_MODEL=
MEETING_SUMMARY_TIMEOUT=300
MEETING_TRANSCRIPT_TOKEN_BUDGET=12000
MEETING_MAX_ITERATIONS=4

# ---------------------------------------------------------------------------
# 存储（默认在项目 data/ 目录下，一般不需要改）
# ---------------------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/app.db
