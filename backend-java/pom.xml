<?xml version="1.0" encoding="UTF-8"?>
<!--
  业务后端（Java 侧）。职责：对前端的 REST/SSE 端点、SQLite 独占读写与增量迁移、
  工作区/文件/消息/提案状态机等业务逻辑；AI 能力（agent、检索、嵌入、MCP 子进程）
  一律经内部 HTTP 委托给 ai-service（FastAPI，8001，仅内网）。
  设计取舍见 docs/（未采用 JPA/Flyway，与原 Python 版 migrations.py 的轻量决策保持一致）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.raglatest</groupId>
  <artifactId>backend-java</artifactId>
  <version>0.1.0</version>
  <name>rag-backend</name>
  <description>业务后端：REST/SSE 网关 + SQLite 持久化，AI 委托 ai-service</description>

  <properties>
    <java.version>21</java.version>
    <wiremock.version>3.13.2</wiremock.version>
    <!-- 与 Spring Cloud 2025.1 对齐；只用核心模块（无 Jackson 依赖），
         刻意不引 resilience4j-spring-boot3 starter：其配置模块依赖 Jackson 2，
         与 Boot 4 的 Jackson 3 有已知摩擦（resilience4j#2351）。
         重试/并发限制用 Spring Framework 7 原生注解（见 ResilienceConfig），
         这里只补框架未内建的熔断与舱壁。 -->
    <resilience4j.version>2.3.0</resilience4j.version>
    <!-- MyBatis-Plus 的 Boot 4 专用 starter（对 Boot 4.0.x 构建；本项目 4.1.x
         实测兼容，见 pom 第 3 节的依赖说明）。 -->
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <!-- 测试用嵌入式 Postgres：默认二进制是 14.x，用 BOM 提到与 compose 的
         postgres:17-alpine 同主版本，避免"测试通过、生产报错"的 DDL 差异。 -->
    <embedded-postgres.version>2.2.2</embedded-postgres.version>
    <embedded-postgres-binaries.version>17.11.0</embedded-postgres-binaries.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.zonky.test.postgres</groupId>
        <artifactId>embedded-postgres-binaries-bom</artifactId>
        <version>${embedded-postgres-binaries.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- 身份与鉴权：账号密码登录（BCrypt）+ 服务端会话。
         session 记录落 Postgres（spring-session-jdbc），因此 backend 重启或
         多实例部署都不会丢失登录态；DDL 由 Flyway 的 V2 迁移持有。
         注意必须用 Boot 的 starter：只放 org.springframework.session:spring-session-jdbc
         上 classpath 时自动配置不会生效（Boot 4 把这段搬进了 spring-boot-session 模块），
         结果是登录态悄悄退回进程内的 Tomcat HttpSession —— 功能看起来正常，
         重启即掉线、多实例不共享。回归靠 AccountFreshnessFilter 之外的
         spring_session 行数断言（见 ApiAuthorizationTests）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-session-jdbc</artifactId>
    </dependency>

    <!-- 持久化：Postgres + Flyway 版本化迁移 + MyBatis-Plus（手写 SQL 与
         BaseMapper 混用，见 store 包注释）。 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- Flyway 的自动配置在 Boot 4 里被拆成独立模块：只放 flyway-core 上 classpath
         是【不够】的，容器里根本不会出现 Flyway 这个 Bean，迁移静默不跑、
         首次查询直接撞 "relation ... does not exist"。与 @WebMvcTest 需要
         spring-boot-starter-webmvc-test 是同一类模块化坑（见 ADR/docs/07）。
         注：starter 只带 flyway-core，Postgres 方言模块仍需显式声明。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <!-- 仅取 WebClient 做 SSE 中继，不引入 reactive server（应用仍是 MVC）。 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>io.projectreactor.netty</groupId>
      <artifactId>reactor-netty-http</artifactId>
    </dependency>

    <!-- 索引任务队列（RabbitMQ，写后重建/上传索引全异步化）。
         消息体用 String + Jackson 3 ObjectMapper 手动序列化，刻意不用
         spring-amqp 的 Jackson2JsonMessageConverter——其绑定 Jackson 2，
         与 Boot 4 的 Jackson 3 有同款摩擦（见上文 resilience4j#2351 先例）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <!-- 读路径缓存（tools/preview/health/retrieval-corpus），Lettuce 客户端。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>

    <!-- 韧性容错：熔断（含 Reactor 操作符）与信号量舱壁。核心模块无 Jackson 依赖。 -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-reactor</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-bulkhead</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 模块化后 @WebMvcTest 切片独立成模块（@WebMvcTest 在
         org.springframework.boot.webmvc.test.autoconfigure）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- standalone 版避免与 Boot 4 自带 Jetty 版本冲突；测试里充当 ai-service 桩。 -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- 可选容器集成测试（命名 *IT，由 failsafe 跑，不进默认 mvnw test；
         默认套件保持全 mock、零 Docker 依赖）。 -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.redis</groupId>
      <artifactId>testcontainers-redis</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 默认测试套件的真实 Postgres：Zonky 嵌入式版本解压官方二进制后本地
         initdb 启动，不依赖 Docker（Docker 守护进程在开发机上并非总是运行，
         `mvnw test` 必须保持零外部依赖），因此 H2/SQLite 冒名顶替的方案都被
         排除——迁移脚本是 Postgres 方言，测试库必须是真的 Postgres。 -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>${embedded-postgres.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- *IT 集成测试（Testcontainers）：只在 verify 阶段跑，需要本机 Docker。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
